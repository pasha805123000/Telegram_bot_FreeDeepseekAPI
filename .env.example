# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# === FreeDeepseekAPI ===
# Адрес прокси-сервера (по умолчанию http://127.0.0.1:9655)
API_BASE_URL=http://127.0.0.1:9655
# Ключ PROXY_API_KEY из .env сервера; пусто, если сервер запущен без ключа
API_KEY=
# Модель (алиас): deepseek-chat, deepseek-reasoner, deepseek-chat-search, deepseek-reasoner-search, deepseek-vision
MODEL=deepseek-chat

# === Поведение бота ===
# Системный промпт (опционально)
SYSTEM_PROMPT=Ты — полезный ассистент. Отвечай на языке пользователя.
# Сколько сообщений истории держать в памяти на пользователя
MAX_HISTORY=40
# Стриминг ответа в реальном времени (1 — вкл, 0 — выкл)
STREAM=1
# Таймаут запроса к серверу, сек
REQUEST_TIMEOUT=180
# Как часто обновлять сообщение бота при стриминге, сек
EDIT_INTERVAL=1.5
# Лимит на загружаемое фото, МБ (на сервере = 7)
IMAGE_MAX_MB=7
